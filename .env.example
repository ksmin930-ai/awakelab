# ==========================================================
# AWAKE LAB 환경 변수 템플릿 (.env.example)
# ==========================================================
# 사용법: 이 파일을 복사하여 .env 로 만들고 실제 키 값을 입력하세요.
# Netlify 배포 시: Netlify Dashboard -> Site configuration -> Environment variables 에 등록합니다.

# 1. Supabase 데이터베이스 설정 (필수)
# Supabase 대시보드 -> Project Settings -> API 에서 확인 가능합니다.
# 주의: SUPABASE_URL의 프로젝트 ID와 SUPABASE_SERVICE_ROLE_KEY의 iss/ref가 반드시 일치해야 합니다.
SUPABASE_URL=https://feuodsqkcwoperitoiqk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 2. 관리자 인증 비밀번호 / PIN (기본값: 1236580* 또는 1236)
ADMIN_SECRET_KEY=1236580*

# 3. Solapi / CoolSMS 문자 & 알림톡 발송 설정
SOLAPI_API_KEY=NCSVL2WDFJJSCETU
SOLAPI_API_SECRET=5XC5NBGUTT9DYPDXMPPQOC81K5JM9OGO
SOLAPI_SENDER_PHONE=01062406569
# SOLAPI_PF_ID=                      # 카카오톡 알림톡 채널 등록 시 사용
# KAKAO_BOOKING_TEMPLATE_CODE=       # 알림톡 예약 신청 접수 템플릿 코드
# KAKAO_CONFIRM_TEMPLATE_CODE=       # 알림톡 예약 확정 템플릿 코드
# KAKAO_PASS_TEMPLATE_CODE=          # 알림톡 정기권 접수 템플릿 코드

# 4. Aligo 발송 설정 (대체 게이트웨이 - 선택)
# ALIGO_API_KEY=
# ALIGO_USER_ID=
# ALIGO_SENDER_PHONE=01062406569
# ALIGO_SENDER_KEY=

# 5. 뱅크다(Bankda) 무통장 자동 입금 확인 웹훅 시크릿 (선택)
# BANKDA_SECRET=
